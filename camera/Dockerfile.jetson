FROM nvcr.io/nvidia/l4t-base:r36.2.0

WORKDIR /app

# Install Python and dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-opencv \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    libgstreamer1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages (skip opencv since we use system version)
COPY camera/requirements.txt .
RUN pip3 install --no-cache-dir grpcio grpcio-tools grpcio-health-checking numpy

# Copy proto file
COPY protos/service.proto ./protos/service.proto

# Copy client code
COPY camera/client.py .

# Generate gRPC code
RUN cd protos && python3 -m grpc_tools.protoc -I. --python_out=../ --grpc_python_out=../ service.proto

CMD ["python3", "-u", "client.py"]
